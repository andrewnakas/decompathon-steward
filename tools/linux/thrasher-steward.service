# systemd user unit for the Thrasher: Skate and Destroy decomp (no AI, no Discord):
#   cp tools/linux/thrasher-steward.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now thrasher-steward
# Runs alongside decompathon-steward.service (thps64): own judge workspace, own data and log dir.
# The judge workspace is a clone of the repo with the disc extracted (disc/files) and the toolchain
# installed (python3 toolchain/setup.py); gates call its own .venv/bin/python.
[Unit]
Description=Decompathon Steward (thrasher-skate-decomp, no AI) under its watchdog
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/decompathon-steward
Environment=PATH=%h/decompathon-steward/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/decompathon-steward/.venv/bin/python -u -m steward.watchdog --log-dir %h/.decompathon/thrasher --module steward.daemon -- --repo andrewnakas/thrasher-skate-decomp --app decompathon-steward --no-ai --judge-workspace %h/thrasher-judge
Nice=5
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
